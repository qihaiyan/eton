#include "resource.h"
#include <winres.h>
#pragma code_page(65001)
LANGUAGE 0x04, 0x02

IDR_ACCEL ACCELERATORS
BEGIN
    "N",  IDM_NEW,      VIRTKEY, CONTROL
    "O",  IDM_OPEN,     VIRTKEY, CONTROL
    "S",  IDM_SAVE,     VIRTKEY, CONTROL
    "W",  IDM_CLOSE,    VIRTKEY, CONTROL
    "F",  IDM_FIND,     VIRTKEY, CONTROL
    "H",  IDM_REPLACE,  VIRTKEY, CONTROL
    "G",  IDM_GOTO,     VIRTKEY, CONTROL
    "Z",  IDM_UNDO,     VIRTKEY, CONTROL
    "Y",  IDM_REDO,     VIRTKEY, CONTROL
    "A",  IDM_SELECTALL,VIRTKEY, CONTROL
    0x72, IDM_FINDNEXT, VIRTKEY
    0x72, IDM_FINDPREV, VIRTKEY, SHIFT
    "F",  IDM_JSON_FMT, VIRTKEY, CONTROL, SHIFT
    "M",  IDM_JSON_MIN, VIRTKEY, CONTROL, SHIFT
    0x09, IDM_NEXT_TAB, VIRTKEY, CONTROL, NOINVERT
    0x09, IDM_PREV_TAB, VIRTKEY, CONTROL, SHIFT, NOINVERT
    0x22, IDM_NEXT_TAB, VIRTKEY, CONTROL, NOINVERT
    0x21, IDM_PREV_TAB, VIRTKEY, CONTROL, NOINVERT
    0x71, IDM_BM_TOGGLE, VIRTKEY, CONTROL, NOINVERT
    0x71, IDM_BM_NEXT,  VIRTKEY, NOINVERT
    0x71, IDM_BM_PREV,  VIRTKEY, SHIFT, NOINVERT
    0x7B, IDM_VIEW_MD,  VIRTKEY
    0x7B, IDM_VIEW_MDSPLT, VIRTKEY, SHIFT
END

IDD_FIND DIALOGEX 0, 0, 316, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "查找"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "查找内容:", IDC_FIND_LBL_TEXT, 10, 14, 44, 8
    EDITTEXT        IDC_FIND_TEXT, 60, 12, 244, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "区分大小写", IDC_FIND_CASE, 10, 34, 90, 10
    AUTOCHECKBOX    "全词匹配",   IDC_FIND_WORD, 110, 34, 90, 10
    AUTOCHECKBOX    "向下",       IDC_FIND_DOWN, 214, 34, 60, 10
    AUTOCHECKBOX    "正则表达式", IDC_FIND_REGEX, 10, 50, 120, 10
    DEFPUSHBUTTON   "查找下一个", IDC_FIND_NEXT, 10, 66, 55, 14
    PUSHBUTTON      "上一个",     IDC_FIND_PREV, 73, 66, 45, 14
    PUSHBUTTON      "关闭",       IDC_FIND_CLOSE, 256, 66, 50, 14
    LTEXT           "", IDC_FIND_STATUS, 10, 88, 296, 8
END

IDD_REPLACE DIALOGEX 0, 0, 316, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "替换"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "查找内容:", IDC_FIND_LBL_TEXT, 10, 14, 44, 8
    EDITTEXT        IDC_FIND_TEXT, 60, 12, 244, 14, ES_AUTOHSCROLL
    LTEXT           "替换为:",   IDC_REPL_LBL_TEXT, 10, 32, 44, 8
    EDITTEXT        IDC_REPL_TEXT, 60, 30, 244, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "区分大小写", IDC_FIND_CASE, 10, 52, 90, 10
    AUTOCHECKBOX    "全词匹配",   IDC_FIND_WORD, 110, 52, 90, 10
    AUTOCHECKBOX    "向下",       IDC_FIND_DOWN, 214, 52, 60, 10
    AUTOCHECKBOX    "正则表达式", IDC_FIND_REGEX, 10, 68, 120, 10
    DEFPUSHBUTTON   "查找下一个", IDC_FIND_NEXT, 10, 84, 55, 14
    PUSHBUTTON      "替换",       IDC_FIND_REPL, 73, 84, 45, 14
    PUSHBUTTON      "全部替换",   IDC_FIND_REPLALL, 126, 84, 45, 14
    PUSHBUTTON      "关闭",       IDC_FIND_CLOSE, 256, 84, 50, 14
    LTEXT           "", IDC_FIND_STATUS, 10, 108, 296, 8
END

IDD_GOTO DIALOGEX 0, 0, 256, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "跳转到行"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "行号:", IDC_GOTO_LABEL, 10, 12, 80, 8
    EDITTEXT        IDC_GOTO_TEXT, 10, 24, 234, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "确定", IDC_GOTO_OK, 84, 50, 72, 14
    PUSHBUTTON      "取消", IDC_GOTO_CANCEL, 164, 50, 72, 14
END

IDD_ABOUT DIALOGEX 0, 0, 300, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 ETON"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "ETON — 轻量级文本编辑器", IDC_ABOUT_LINE1, 20, 20, 260, 8
    LTEXT           "基于原生 Win32 API (C) 实现，零第三方依赖。", IDC_ABOUT_LINE2, 20, 44, 260, 8
    LTEXT           "支持多标签、语法高亮、编码转换、查找替换等。", IDC_ABOUT_LINE3, 20, 68, 260, 8
    LTEXT           "", IDC_ABOUT_LINE4, 20, 92, 260, 8
    DEFPUSHBUTTON   "确定", IDC_GOTO_OK, 114, 108, 72, 14
END

IDD_OPENENC DIALOGEX 0, 0, 236, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "以指定编码打开"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "选择编码:", IDC_OPENENC_LBL, 12, 14, 200, 8
    LISTBOX         IDC_OPENENC_LIST, 12, 28, 212, 74, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
    DEFPUSHBUTTON   "确定", IDC_GOTO_OK, 60, 110, 72, 14
    PUSHBUTTON      "取消", IDC_GOTO_CANCEL, 148, 110, 72, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 280, 68
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "ETON"
FONT 9, "Microsoft YaHei"
BEGIN
    LTEXT           "", IDC_PROG_TEXT, 10, 12, 260, 10
    CONTROL         "", IDC_PROG_BAR, "msctls_progress32", WS_CHILD | WS_VISIBLE, 10, 30, 260, 12
    PUSHBUTTON      "取消", IDC_PROG_CANCEL, 114, 48, 52, 14
END

IDI_APP ICON "..\\res\\app.ico"

IDR_MERMAID_JS RCDATA "..\\deps\\mermaid\\mermaid.min.js"

#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ET_VERSION_MAJOR,ET_VERSION_MINOR,ET_VERSION_PATCH,0
 PRODUCTVERSION ET_VERSION_MAJOR,ET_VERSION_MINOR,ET_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "海易华天"
            VALUE "FileDescription",  "ETON text editor"
            VALUE "FileVersion",      ET_VERSION_STR
            VALUE "InternalName",     "eton"
            VALUE "LegalCopyright",   "Copyright (C) 2026 海易华天"
            VALUE "OriginalFilename", "eton.exe"
            VALUE "ProductName",      "ETON"
            VALUE "ProductVersion",   ET_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
