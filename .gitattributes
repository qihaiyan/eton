# Batch files must stay CRLF: cmd's goto/label handling breaks on LF-only .bat
*.bat text eol=crlf
*.cmd text eol=crlf

# Normal text, repo stores LF, checkout uses native endings
*.c text
*.h text
*.rc text
*.md text
*.py text
*.yml text
*.manifest text

# Binaries
*.lib binary
*.ico binary
*.exe binary
